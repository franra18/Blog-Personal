---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/blog/BlogPost.astro';

const allPosts = await getCollection('blog');
const pageTitle = "Blog";
---

<BaseLayout pageTitle={pageTitle}>
        <p>Bienvenido a mi blog. Aquí compartiré mis pensamientos, experiencias y novedades sobre mi recorrido con Astro y el desarrollo web.</p>
        <ul>
            {allPosts.map((post: any) => (<BlogPost url={`/posts/${post.id}`} title={post.data.title} />))}
        </ul>
</BaseLayout>
