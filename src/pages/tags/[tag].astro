---
import { getCollection } from 'astro:content';
import BlogPost from '../../components/BlogPost.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');

  const uniqueTags = [...new Set(allPosts.map((post: any) => post.data.tags).flat())]; /* Crea un array de tags únicos a partir de todos los posts. */

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post: any) => post.data.tags.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts }
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout pageTitle={tag}>
  <p>Publicaciones etiquetadas con {tag}</p>
  <ul>
    {posts.map((post: any) => <BlogPost url={`/posts/${post.id}`} title={post.data.title}/>)}
  </ul>
</BaseLayout>
