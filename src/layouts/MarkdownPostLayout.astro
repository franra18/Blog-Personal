---
import BaseLayout from './BaseLayout.astro';
const { frontmatter} = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
    <p>Publicado el {frontmatter.pubDate.toLocaleDateString()}</p>    
    <!-- <p><em>{frontmatter.description}</em></p> --> <!-- Descripción del post (de momento oculta) -->
    <img src={frontmatter.image.url} width="100%" alt={frontmatter.image.alt} />
    <p>Francisco Ramírez Cañadas</p>

    <div class="tags">
        {frontmatter.tags.map((tag: string) => (
        <p class="tag"><a href={`/projects/${tag}`}>{tag}</a></p>
        ))}
    </div>

    <slot /> <!-- MUY IMPORTANTE -->
</BaseLayout>

<style>
  a {
    color: #00539F;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: .5em;
    padding: .5em 1em;
    font-size: 1.15em;
    background-color: #F8FCFD;
  }
</style>
