---
const { platform, username } = Astro.props; /* Recibe variables de las páginas */
---

<a target="_blank" href={`https://${platform}.com/${username}`}>{platform}</a>

<style>
    a {
        padding: 0.5rem 1rem;
        background-color: #4c1d95;
        text-decoration: none;
        color: white;
    }
</style>
