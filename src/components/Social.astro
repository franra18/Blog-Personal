---
const { platform, username } = Astro.props; /* Recibe variables de las páginas */
---

<a class="border-black border bg-white p-2 size-10 xs:size-12 flex items-center justify-center rounded-full hover:scale-110 transition-transform animate-slide-up-fade" href={`https://${platform}.com/${username}`} target="_blank"
    aria-label={platform} title={`${platform} | ${username}`}>
    <svg>
        <use href=`/assets/sprite.svg#${platform}` />
    </svg>
</a>
